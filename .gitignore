# Scratch outputs from content swarm / SEO scripts.
# Blanket rule: every underscore-prefixed path under scripts/ is scratch.
# This repo is PUBLIC — the SEO tooling writes OAuth token caches
# (_gsc_token.json), Search Console exports and derived batches into
# scripts/_* files, none of which may ever be committed. The blanket
# pattern only affects untracked files, so previously committed _-files
# (e.g. the wave plan/writer manifests) are unaffected.
/scripts/_*
/scripts/_gap_plan.json
/scripts/_dedup_delete.txt
/scripts/_swarm_prompts/
/scripts/_proposer_briefs.json
/scripts/_existing_slugs.txt
/scripts/_proposals/
/scripts/_proposer_prompts/
/scripts/_locked_plan.json
/scripts/_writer_prompts/
scripts/_sec_tickers.json
scripts/_companies_plan.json
scripts/_company_allowlist.txt
scripts/_company_batches/
